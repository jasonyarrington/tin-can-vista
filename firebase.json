{
  "hosting": {
    "public": "output",
    "cleanUrls": true,
    "trailingSlash": true,
    "ignore": ["firebase.json", "**/.*"],
    "headers": [
      {
        "source": "**/*.@(css|woff2|jpg|jpeg|png|webp|svg|gif)",
        "headers": [{"key": "Cache-Control", "value": "public, max-age=86400"}]
      }
    ]
  }
}
